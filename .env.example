# Database
# [本地开发环境] 请配置本地或外部的数据库连接地址
DATABASE_URL="postgresql://license_auth:your-password@localhost:5432/license_auth"

# [Docker 部署环境] 以下参数用于配置 Docker compose 内部的数据库服务 (无需修改 DATABASE_URL)
POSTGRES_USER=license_auth
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=license_auth

# Authentication
JWT_SECRET="your-jwt-secret-min-16-chars"

# 混淆门户安全路径（自定义安全入口，访问该路径刷卡进入控制台）
PORTAL_SECURITY_PATH="your-secret-portal-path"

# 门禁保护的页面范围（逗号分隔，可选：home, admin, user）
PORTAL_PROTECTED_PATHS="home,admin,user"

# Optional: Setup token for first admin creation
# SETUP_TOKEN="your-setup-token-here"

# Cloudflare Turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
# TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# API Encryption
AES_SECRET_KEY="your-aes-secret-key"
