// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id              String     @id @default(cuid())
  username        String     @unique
  password        String
  role            String     // "owner" or "admin"
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  createdUsers    User[]     @relation("UserCreator")
  createdLicenses License[]  @relation("LicenseCreator")
  auditLogs       AuditLog[]

  @@index([role])
}

model User {
  id          String    @id @default(cuid())
  username    String
  userHash    String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  licenses    License[]
  createdById String?
  createdBy   Admin?    @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([username])
  @@index([createdById])
}

model Software {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
}

model License {
  id                     String    @id @default(cuid())
  licenseKey             String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String
  softwareName           String
  expirationDate         DateTime
  hwid                   String?
  deviceName             String?
  hardwareBindingEnabled Boolean   @default(false)
  allowSelfUnbind        Boolean   @default(true)
  status                 String    @default("active")
  licenseType            String    @default("fixed") // "fixed" or "duration"
  duration               Int?      // Duration in minutes
  activatedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  sessions               Session[]
  hardwareHistories      LicenseHardwareHistory[]
  lastUnboundAt          DateTime?
  monthlyUnbindCount     Int       @default(0)
  unbindCountMonth       String?
  extraUnbindCount       Int       @default(0)
  createdById            String?
  createdBy              Admin?    @relation("LicenseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([licenseType])
  @@index([status, expirationDate])
  @@index([activatedAt])
  @@index([createdById])
}

model Blacklist {
  id        String    @id @default(cuid())
  type      String    // "ip" | "hwid"
  value     String    // 具体的 IP 地址 或 HWID
  reason    String?   // 拉黑原因
  isAuto    Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([type, value])
  @@index([type])
  @@index([value])
  @@index([expiresAt])
}

model NotificationChannel {
  id        String   @id @default(cuid())
  name      String   // 通道名称
  type      String   // "bark" | "feishu" | "dingtalk" | "telegram" | "generic"
  url       String   // 目标 URL 或 Bark Push 端点
  secret    String?  // 密钥 / Key / Token
  enabled   Boolean  @default(true)
  events    String   @default("[\"all\"]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

model SoftwareVersion {
  id           String   @id @default(cuid())
  softwareName String
  version      String
  versionCode  Int
  changelog    String
  downloadUrl  String
  fileHash     String?
  isForced     Boolean  @default(false)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([softwareName, versionCode])
  @@index([enabled])
}

model Announcement {
  id           String   @id @default(cuid())
  softwareName String   @default("ALL")
  title        String
  content      String
  type         String   @default("info")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([softwareName, enabled])
}

model Session {
  id            String   @id @default(cuid())
  licenseKey    String
  license       License  @relation(fields: [licenseKey], references: [licenseKey], onDelete: Cascade)
  hwid          String?
  ipAddress     String?
  lastHeartbeat DateTime @default(now())
  status        String   @default("active")
  terminatedAt  DateTime? // 终止下线时间
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([licenseKey])
  @@index([licenseKey, hwid])
  @@index([status, lastHeartbeat])
  @@index([ipAddress])
}

model LicenseHardwareHistory {
  id           String   @id @default(cuid())
  licenseKey   String
  hwid         String
  deviceName   String?
  firstBoundAt DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  license      License  @relation(fields: [licenseKey], references: [licenseKey], onDelete: Cascade)

  @@unique([licenseKey, hwid])
  @@index([licenseKey])
  @@index([hwid])
  @@index([lastSeenAt])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String   // "create_license" | "revoke_license" | "suspend_license" | "resume_license" | "edit_license" | "delete_user" | "kick_session"
  targetType String   // "license" | "user" | "session"
  targetId   String
  details    String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model VerificationAttempt {
  id         String   @id @default(cuid())
  licenseKey String?
  ipAddress  String
  success    Boolean
  reason     String?
  createdAt  DateTime @default(now())

  @@index([ipAddress, success, createdAt])
  @@index([licenseKey])
  @@index([createdAt])
}
